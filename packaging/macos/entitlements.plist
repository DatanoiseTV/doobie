<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for Doobie. Notarization requires the
  hardened runtime; these entitlements declare the few exceptions an audio
  plug-in actually needs.

  - allow-unsigned-executable-memory:  juce_dsp's FFT path JIT-compiles
    small kernels in some configurations; this exception keeps that safe
    under hardened runtime.
  - disable-library-validation:  AU/VST3 hosts load Doobie as a plug-in
    bundle inside their own process — without this the host's own
    signature requirement collides with ours.
  - audio-input:  Standalone wraps the same code as the plug-in and may
    request mic access if the user routes one in.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- allow-jit gates the modern MAP_JIT API JavaScriptCore (inside
         WKWebView) uses on macOS Sequoia+. allow-unsigned-executable-memory
         covers the older, broader exception (kept for juce_dsp's FFT JIT
         path) but does not by itself satisfy the new check. Without
         allow-jit, JSC silently falls back to the interpreter on some
         Apple Silicon configurations and the WebView UI can refuse to
         render JIT-heavy pages. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
